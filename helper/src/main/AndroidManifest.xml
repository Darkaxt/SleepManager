<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="com.med.sleepmanager.helper.permission.CONTROL"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.med.sleepmanager.permission.CONTROL_HELPER" />
    <uses-permission android:name="com.med.sleepmanager.helper.permission.CONTROL" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:label="SleepManager Helper"
        android:hasCode="true">

        <activity
            android:name=".HelperActivationActivity"
            android:enabled="true"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:permission="com.med.sleepmanager.permission.CONTROL_HELPER"
            android:theme="@android:style/Theme.NoDisplay" />

        <activity
            android:name=".HelperActivationActivityV2"
            android:enabled="true"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:permission="com.med.sleepmanager.helper.permission.CONTROL"
            android:theme="@android:style/Theme.NoDisplay" />

        <service
            android:name=".HelperCommandServiceV2"
            android:enabled="true"
            android:exported="true"
            android:permission="com.med.sleepmanager.helper.permission.CONTROL"
            android:stopWithTask="false" />

        <receiver
            android:name=".SleepManagerHelperReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="com.med.sleepmanager.permission.CONTROL_HELPER">
            <intent-filter>
                <action android:name="com.med.sleepmanager.helper.action.SLEEP" />
                <action android:name="com.med.sleepmanager.helper.action.WAKE" />
                <action android:name="com.med.sleepmanager.helper.action.RESTORE" />
                <action android:name="com.med.sleepmanager.helper.action.QUERY_STATE" />
                <action android:name="com.med.sleepmanager.helper.action.SET_TEMP_WIFI" />
                <action android:name="com.med.sleepmanager.helper.action.FORGET_STATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".SleepManagerHelperReceiverV2"
            android:enabled="true"
            android:exported="true"
            android:permission="com.med.sleepmanager.helper.permission.CONTROL">
            <intent-filter>
                <action android:name="com.med.sleepmanager.helper.action.SLEEP" />
                <action android:name="com.med.sleepmanager.helper.action.WAKE" />
                <action android:name="com.med.sleepmanager.helper.action.RESTORE" />
                <action android:name="com.med.sleepmanager.helper.action.QUERY_STATE" />
                <action android:name="com.med.sleepmanager.helper.action.SET_TEMP_WIFI" />
                <action android:name="com.med.sleepmanager.helper.action.FORGET_STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
